<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>인생역전! 로또 번호 추천</title>
    <style>
      :root {
        --bg-color: #f8f9fa;
        --primary-color: #4a90e2;
        --primary-hover: #357abd;
        --text-color: #333;
        --ball-shadow: rgba(0, 0, 0, 0.2);

        /* Lotto Ball Colors */
        --color-1-10: #fbc400; /* Yellow */
        --color-11-20: #69c8f2; /* Blue */
        --color-21-30: #ff7272; /* Red */
        --color-31-40: #aaaaaa; /* Gray */
        --color-41-45: #b0d840; /* Green */
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
        font-family:
          'Pretendard',
          -apple-system,
          BlinkMacSystemFont,
          system-ui,
          Roboto,
          'Helvetica Neue',
          'Segoe UI',
          'Apple SD Gothic Neo',
          'Noto Sans KR',
          'Malgun Gothic',
          sans-serif;
      }

      body {
        background-color: var(--bg-color);
        color: var(--text-color);
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        padding: 20px;
      }

      .container {
        width: 100%;
        max-width: 500px;
        background: white;
        padding: 40px 20px;
        border-radius: 24px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
        text-align: center;
      }

      h1 {
        font-size: 1.8rem;
        margin-bottom: 30px;
        color: #222;
      }

      .ball-container {
        display: flex;
        justify-content: center;
        gap: 12px;
        margin-bottom: 40px;
        min-height: 60px;
        flex-wrap: wrap;
      }

      .ball {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        font-weight: bold;
        font-size: 1.2rem;
        color: white;
        text-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
        box-shadow:
          inset -4px -4px 8px rgba(0, 0, 0, 0.15),
          4px 4px 10px var(--ball-shadow);
        opacity: 0;
        transform: scale(0.5) translateY(20px);
      }

      .ball.show {
        animation: popIn 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
      }

      @keyframes popIn {
        0% {
          opacity: 0;
          transform: scale(0.5) translateY(20px);
        }
        100% {
          opacity: 1;
          transform: scale(1) translateY(0);
        }
      }

      /* Ball Color Classes */
      .ball.yellow {
        background: radial-gradient(
          circle at 30% 30%,
          #ffd94d,
          var(--color-1-10)
        );
      }
      .ball.blue {
        background: radial-gradient(
          circle at 30% 30%,
          #8ed8f7,
          var(--color-11-20)
        );
      }
      .ball.red {
        background: radial-gradient(
          circle at 30% 30%,
          #ff9e9e,
          var(--color-21-30)
        );
      }
      .ball.gray {
        background: radial-gradient(
          circle at 30% 30%,
          #cccccc,
          var(--color-31-40)
        );
      }
      .ball.green {
        background: radial-gradient(
          circle at 30% 30%,
          #c8e66e,
          var(--color-41-45)
        );
      }

      .draw-btn {
        background-color: var(--primary-color);
        color: white;
        border: none;
        padding: 16px 40px;
        font-size: 1.2rem;
        font-weight: 600;
        border-radius: 12px;
        cursor: pointer;
        transition: all 0.2s;
        box-shadow: 0 4px 15px rgba(74, 144, 226, 0.3);
        margin-bottom: 30px;
      }

      .draw-btn:hover {
        background-color: var(--primary-hover);
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(74, 144, 226, 0.4);
      }

      .draw-btn:active {
        transform: translateY(0);
      }

      .history-section {
        border-top: 1px solid #eee;
        padding-top: 20px;
      }

      .history-title {
        font-size: 0.9rem;
        color: #888;
        margin-bottom: 15px;
      }

      .history-list {
        list-style: none;
        max-height: 200px;
        overflow-y: auto;
      }

      .history-item {
        display: flex;
        justify-content: center;
        gap: 5px;
        margin-bottom: 8px;
        animation: fadeIn 0.3s ease-out;
      }

      .history-ball {
        width: 24px;
        height: 24px;
        border-radius: 50%;
        font-size: 0.7rem;
        display: flex;
        justify-content: center;
        align-items: center;
        color: white;
        font-weight: bold;
      }

      @keyframes fadeIn {
        from {
          opacity: 0;
          transform: translateY(-5px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      /* Mobile Adjustments */
      @media (max-width: 400px) {
        .ball {
          width: 40px;
          height: 40px;
          font-size: 1rem;
        }
        .container {
          padding: 30px 15px;
        }
      }
    </style>
  </head>
  <body>
    <div class="container">
      <h1>🍀 로또 번호 추천</h1>

      <div id="ballContainer" class="ball-container">
        <!-- Balls will appear here -->
      </div>

      <button id="drawBtn" class="draw-btn">번호 생성하기</button>

      <div class="history-section">
        <p class="history-title">최근 추천 내역</p>
        <div id="historyList" class="history-list">
          <!-- History items will appear here -->
        </div>
      </div>
    </div>

    <script>
      const ballContainer = document.getElementById('ballContainer');
      const drawBtn = document.getElementById('drawBtn');
      const historyList = document.getElementById('historyList');

      function getBallColorClass(num) {
        if (num <= 10) return 'yellow';
        if (num <= 20) return 'blue';
        if (num <= 30) return 'red';
        if (num <= 40) return 'gray';
        return 'green';
      }

      function generateLottoNumbers() {
        const numbers = [];
        while (numbers.length < 6) {
          const r = Math.floor(Math.random() * 45) + 1;
          if (numbers.indexOf(r) === -1) numbers.push(r);
        }
        return numbers.sort((a, b) => a - b);
      }

      function createBall(num, index) {
        const ball = document.createElement('div');
        ball.className = `ball ${getBallColorClass(num)}`;
        ball.textContent = num;

        ballContainer.appendChild(ball);

        // Staggered animation
        setTimeout(() => {
          ball.classList.add('show');
        }, index * 150);
      }

      function addToHistory(numbers) {
        const item = document.createElement('div');
        item.className = 'history-item';

        numbers.forEach((num) => {
          const hBall = document.createElement('div');
          hBall.className = `history-ball ${getBallColorClass(num)}`;
          hBall.style.backgroundColor = `var(--color-${getBallColorClass(num).replace('yellow', '1-10').replace('blue', '11-20').replace('red', '21-30').replace('gray', '31-40').replace('green', '41-45')})`;

          // Manually apply background color because CSS variables in nested classes can be tricky
          const colorMap = {
            yellow: '#fbc400',
            blue: '#69c8f2',
            red: '#ff7272',
            gray: '#aaaaaa',
            green: '#b0d840',
          };
          hBall.style.backgroundColor = colorMap[getBallColorClass(num)];

          hBall.textContent = num;
          item.appendChild(hBall);
        });

        if (historyList.firstChild) {
          historyList.insertBefore(item, historyList.firstChild);
        } else {
          historyList.appendChild(item);
        }

        // Keep only last 10
        while (historyList.children.length > 10) {
          historyList.removeChild(historyList.lastChild);
        }
      }

      drawBtn.addEventListener('click', () => {
        // Disable button during animation
        drawBtn.disabled = true;
        drawBtn.textContent = '추첨 중...';

        // Clear previous balls
        ballContainer.innerHTML = '';

        const numbers = generateLottoNumbers();

        numbers.forEach((num, index) => {
          createBall(num, index);
        });

        // Re-enable button after all balls shown
        setTimeout(
          () => {
            drawBtn.disabled = false;
            drawBtn.textContent = '번호 생성하기';
            addToHistory(numbers);
          },
          6 * 150 + 500,
        );
      });

      // Initial draw
      // window.onload = () => drawBtn.click();
    </script>
  </body>
</html>
